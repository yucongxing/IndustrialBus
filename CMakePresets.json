{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Linux GCC Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "INDUSTRIAL_BUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Linux GCC Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "INDUSTRIAL_BUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-only",
      "inherits": "debug",
      "displayName": "Dependency-free core",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "INDUSTRIAL_BUS_ENABLE_PROTOBUF": "OFF",
        "INDUSTRIAL_BUS_ENABLE_ZEROMQ": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
